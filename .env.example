# Copy to .env and fill in real values before running `docker compose up`.
# See README.md "Environment variables" for the full reference.

AXON_SERVER_NAME=matrix.example.com

DB_USER=axon
# Required. The server refuses to boot without it (config/runtime.exs) —
# there is no default, deliberately.
DB_PASS=
DB_NAME=axon_prod
POOL_SIZE=20

# Required. Generate with: openssl rand -hex 32
# Keys every signed/encrypted cookie, CSRF token and Phoenix.Token this
# server issues. No default and no fallback: leave it blank and the server
# refuses to boot (config/runtime.exs) rather than starting with a
# guessable key.
SECRET_KEY_BASE=

# Optional: shared secret for the Synapse-compatible admin bootstrap
# endpoint, POST /_synapse/admin/v1/register. Leave unset and that endpoint
# (plus its nonce companion) answers 404 M_UNRECOGNIZED — set it only while
# you need to mint the first admin account, then unset it again. Generate
# with: openssl rand -hex 32
# REGISTRATION_SHARED_SECRET=

# Optional: allow remote-media download/thumbnail proxying to reach
# private/loopback/link-local addresses. Leave unset (false) on any real
# deployment — those endpoints take the origin server name straight from the
# request URL, so turning this on hands unauthenticated callers an SSRF
# primitive against your internal network. Exists for the Complement
# harness, whose homeservers all live on a private Docker network.
# FEDERATION_ALLOW_PRIVATE_ADDRESSES=false

# Optional: delegated OIDC login
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_AUTH_METHOD=client_secret_basic
# OIDC_ACCOUNT_MANAGEMENT_URL=

# Optional: Sentry error tracking (added in Phase 15.3) — leave unset to no-op
# SENTRY_DSN=

# Optional: identity server for 3pid (email/phone) invites. See README.md
# "Identity server (3pid invites)" — for local dev, run
# `docker compose -f docker-compose.identity.yml up -d` (Sydent) and point
# this at it: http://localhost:8090
# DEFAULT_IDENTITY_SERVER=

# Optional: path (on a persistent volume) to keep the server's federation
# signing key across restarts — leave unset and a fresh one is generated in
# memory every restart, invalidating cached /_matrix/key/v2/server
# responses and signatures other servers already verified. Written on
# first boot if the file doesn't exist yet. docker-compose.yml already
# mounts a volume at this default path.
# SIGNING_KEY_PATH=/axon/data/signing.key
